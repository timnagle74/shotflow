# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Bunny.net Storage (ProRes downloads)
BUNNY_STORAGE_ZONE="your-storage-zone"
BUNNY_STORAGE_HOSTNAME="storage.bunnycdn.com"
BUNNY_STORAGE_PASSWORD="your-storage-password"
BUNNY_STORAGE_CDN_URL="https://your-storage-zone.b-cdn.net"

# Bunny.net Stream (HLS playback)
BUNNY_STREAM_LIBRARY_ID="your-library-id"
BUNNY_STREAM_API_KEY="your-stream-api-key"
NEXT_PUBLIC_BUNNY_STREAM_CDN="https://your-stream-cdn.b-cdn.net"
NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID="your-library-id"

# S3-compatible staging bucket for vendor uploads.
# Used for the prepare-upload → PUT → finalize flow (Bunny Stream fetches from this).
# Cloudflare R2 is recommended (free egress, no self-hosting):
#   S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
#   S3_ACCESS_KEY="<r2 access key id>"
#   S3_SECRET_KEY="<r2 secret access key>"
#   S3_BUCKET="shotflow-transfers"
#   S3_REGION="auto"
# Bucket needs CORS: allow PUT/GET/HEAD from your app origins, Content-Type header, expose ETag.
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="shotflow-transfers"
S3_REGION="auto"
